    "Only today's and overdue reminders show here — pull to refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only today's and overdue reminders show here — pull to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示今天和过期的提醒——下拉刷新。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se muestran los recordatorios de hoy y vencidos: tira para actualizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには今日と期限切れのリマインダーだけが表示されます。下に引いて更新してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
